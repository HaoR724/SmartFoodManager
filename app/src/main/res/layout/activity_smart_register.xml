<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_panel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="创建账号"
            android:textColor="@color/smart_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:hint="@string/username"
            android:textColorHint="@color/smart_text_secondary"
            android:textColor="@color/smart_text_primary"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:hint="@string/password"
            android:textColorHint="@color/smart_text_secondary"
            android:inputType="textPassword"
            android:textColor="@color/smart_text_primary"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:hint="@string/confirm_password"
            android:textColorHint="@color/smart_text_secondary"
            android:inputType="textPassword"
            android:textColor="@color/smart_text_primary"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:hint="@string/nickname"
            android:textColorHint="@color/smart_text_secondary"
            android:textColor="@color/smart_text_primary"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_smart_button"
            android:elevation="10dp"
            android:text="@string/register"
            android:textColor="@color/smart_button_text" />
    </LinearLayout>
</ScrollView>
