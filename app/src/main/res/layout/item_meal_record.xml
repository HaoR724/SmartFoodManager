<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_smart_card"
    android:elevation="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_meal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/smart_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_meal_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/smart_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:gravity="right|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_meal_edit"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_smart_button_secondary"
            android:gravity="center"
            android:text="编辑"
            android:textColor="@color/smart_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_meal_delete"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_smart_button_secondary"
            android:gravity="center"
            android:text="删除"
            android:textColor="@color/smart_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
