<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_panel"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_title_bar"
        android:elevation="10dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="智膳管家"
        android:textColor="@color/smart_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@drawable/bg_page_panel"
        android:paddingLeft="18dp"
        android:paddingTop="8dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="14dp"
            app:itemIconTint="@color/nav_item_tint"
            app:itemTextColor="@color/nav_item_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_main_bottom" />

        <View
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_glow" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_quick_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:elevation="18dp"
            android:outlineAmbientShadowColor="@color/smart_primary"
            android:outlineSpotShadowColor="@color/smart_primary"
            android:src="@drawable/ic_add_plus"
            app:backgroundTint="@color/smart_primary"
            app:borderWidth="0dp"
            app:tint="@color/smart_text_primary" />
    </FrameLayout>
</LinearLayout>
