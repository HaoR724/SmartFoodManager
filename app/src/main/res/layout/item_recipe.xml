<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_smart_card"
    android:elevation="12dp"
    android:orientation="horizontal">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="88dp"
        android:layout_height="76dp"
        android:layout_marginRight="14dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        app:cardBackgroundColor="@color/smart_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_recipe_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_recipe_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="@color/smart_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_recipe_score"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_warm_chip"
                android:gravity="center"
                android:minWidth="76dp"
                android:textColor="@color/smart_nav"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_recipe_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="@color/smart_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_recipe_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:textColor="@color/smart_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
