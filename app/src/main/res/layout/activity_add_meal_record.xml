<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_panel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_meal_form_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="添加饮食记录"
            android:textColor="@color/smart_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_meal_date"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:hint="日期 yyyy-MM-dd"
            android:singleLine="true"
            android:textColor="@color/smart_text_primary"
            android:textColorHint="@color/smart_text_secondary" />

        <TextView
            android:id="@+id/sp_meal_type"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/smart_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sp_food_category"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/smart_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sp_food_name"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/smart_text_primary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/et_amount_gram"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_smart_input"
            android:elevation="6dp"
            android:hint="食用重量（克）"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="@color/smart_text_primary"
            android:textColorHint="@color/smart_text_secondary" />

        <TextView
            android:id="@+id/tv_nutrition_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_smart_card"
            android:elevation="12dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/smart_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_save_meal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_smart_button"
            android:elevation="10dp"
            android:text="保存记录"
            android:textColor="@color/smart_button_text" />
    </LinearLayout>
</ScrollView>
