<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_panel">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="82dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="16dp"
            android:paddingRight="18dp"
            android:paddingBottom="96dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_title_health"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:text="膳食分析"
                android:textColor="@color/smart_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_health_segment_container"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_analyze_today"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_health_segment_selected"
                    android:gravity="center"
                    android:text="今日分析"
                    android:textColor="@color/smart_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_analyze_month"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_health_segment_unselected"
                    android:gravity="center"
                    android:text="近30天分析"
                    android:textColor="#7D8792"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_nutrition_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_health_dashboard_card"
                android:elevation="12dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="126dp">

                    <TextView
                        android:id="@+id/tv_analysis_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="摄入估算"
                        android:textColor="@color/smart_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_calorie_gap"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="top|right"
                        android:background="@drawable/bg_health_gap_chip"
                        android:gravity="center"
                        android:text="缺口 0 kcal"
                        android:textColor="@color/smart_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_calorie_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="50sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_calorie_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="/ 2000 kcal"
                            android:textColor="#AAB2BD"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_protein_line"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:text="蛋白质"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/progress_protein"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="7dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_health_orange" />

                        <TextView
                            android:id="@+id/tv_protein_status"
                            android:layout_width="74dp"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_fat_line"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:text="脂肪"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/progress_fat"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="7dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_health_cyan" />

                        <TextView
                            android:id="@+id/tv_fat_status"
                            android:layout_width="74dp"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_carb_line"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:text="碳水"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/progress_carb"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="7dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_health_blue" />

                        <TextView
                            android:id="@+id/tv_carb_status"
                            android:layout_width="74dp"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="3"
                    android:rowCount="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_health_micro_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="纤维"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_fiber_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_health_micro_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="钙"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_calcium_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_health_micro_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="铁"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_iron_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_health_micro_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="维C"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_vitamin_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_health_micro_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="记录天数"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_day_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_health_micro_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="餐次"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_record_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_health_ai_card"
                android:elevation="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ai_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✦ Next Meal Suggestion"
                    android:textColor="@color/smart_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_health_suggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_record_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="今日饮食记录"
                android:textColor="@color/smart_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_meal_empty"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_smart_empty"
                android:elevation="8dp"
                android:gravity="center"
                android:text="暂无饮食记录，请点击右下角 + 添加"
                android:textColor="@color/smart_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_meal_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/btn_generate_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="生成本月三餐演示数据"
                android:textColor="#66707A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_health_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="说明：本系统仅根据饮食记录估算营养摄入情况，不作为医学诊断依据。"
                android:textColor="#4DFFF3D6"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="right|bottom"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_fab_glow" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_add_meal_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="22dp"
        android:contentDescription="添加饮食记录"
        app:backgroundTint="@color/smart_primary"
        app:elevation="10dp"
        app:srcCompat="@drawable/ic_add_plus"
        app:tint="@color/smart_text_primary" />
</FrameLayout>
