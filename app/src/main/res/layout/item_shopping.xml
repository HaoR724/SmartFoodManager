<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_smart_card"
    android:elevation="12dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_check_box"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_warm_chip"
        android:gravity="center"
        android:textColor="@color/smart_nav"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_shopping_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/smart_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_shopping_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/smart_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_add_to_stock"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_smart_button"
        android:elevation="8dp"
        android:minWidth="88dp"
        android:text="加入库存"
        android:textColor="@color/smart_button_text"
        android:textSize="13sp" />
</LinearLayout>
