<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Chapter01">
        <activity
            android:name="com.example.smartfood.activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.smartfood.activity.RegisterActivity" />
        <activity android:name="com.example.smartfood.activity.MainActivity" />
        <activity android:name="com.example.smartfood.activity.AddIngredientActivity" />
        <activity android:name="com.example.smartfood.activity.RecipeDetailActivity" />
        <activity android:name="com.example.smartfood.activity.AddMealRecordActivity" />
        <activity android:name="com.example.smartfood.activity.ShoppingListActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".txt" />
    </application>

</manifest>
